SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
DATABASE_URL=sqlite:///fortitrade.db
FIREWORKS_API_KEY=your-fireworks-api-key-here
GEMMA_MODEL_ID=accounts/fireworks/models/your-model-id-here
CORS_ORIGINS=http://localhost:5173
# Safe default: orders go to Binance Spot Testnet only.
BINANCE_ENV=testnet
BINANCE_API_KEY=your-testnet-api-key
BINANCE_API_SECRET=your-testnet-api-secret
MAX_ORDER_NOTIONAL_USDT=100
ORDER_TIMEOUT_SECONDS=10
# Live trading requires all of these, a strong secret pair, and the API request
# field confirm_live_trade=true. Do not put customer API keys in this app.
# BINANCE_ENV=live
# LIVE_TRADING_ENABLED=true
# OPERATOR_USER_EMAIL=operator@example.com
